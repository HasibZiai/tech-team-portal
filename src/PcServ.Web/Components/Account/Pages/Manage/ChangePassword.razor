@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using PcServ.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject SettingsService Settings
@inject ILogger<ChangePassword> Logger

<PageTitle>Change password · Tech Team Portal</PageTitle>

<h2 class="h5">Change password</h2>
@if (user?.MustChangePassword == true)
{
    <div class="alert alert-warning" role="alert">@_forcedMessage</div>
}
<StatusMessage Message="@message" />
<div class="row">
    <div class="col-xl-8">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Current password" />
                <label for="Input.OldPassword" class="form-label">@(user?.MustChangePassword == true ? "Temporary password" : "Current password")</label>
                <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="New password" />
                <label for="Input.NewPassword" class="form-label">New password (at least 10 characters)</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
                <label for="Input.ConfirmPassword" class="form-label">Confirm new password</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Update password</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private string _forcedMessage = "";
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _forcedMessage = await Settings.QuipAsync(QuipMoment.PasswordChange);

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (Input.OldPassword == Input.NewPassword)
        {
            message = "Error: Your new password must be different from the current one.";
            return;
        }

        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(" ", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        var wasForced = user.MustChangePassword;
        if (wasForced)
        {
            user.MustChangePassword = false;
            await UserManager.UpdateAsync(user);
        }

        // Re-issues the sign-in cookie without the "must change password" flag.
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User {UserName} changed their password.", user.UserName);

        if (wasForced)
        {
            RedirectManager.RedirectTo("");
        }
        else
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Your password has been changed.", HttpContext);
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Choose a new password.")]
        [StringLength(100, ErrorMessage = "The new password must be at least {2} characters.", MinimumLength = 10)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessage = "The new passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
