@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <MudText>Give this temporary password to <strong>@UserName</strong>. They'll be asked to choose a new one when they sign in.</MudText>
        <div class="temp-password mt-4">
            <code>@Password</code>
            <MudIconButton Icon="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)"
                           Color="@(_copied ? Color.Success : Color.Default)" aria-label="Copy password" OnClick="Copy" />
        </div>
        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-4">
            This is the only time it will be shown. Share it in person or by phone, not by email or chat.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string Password { get; set; } = "";

    private bool _copied;

    private async Task Copy()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            _copied = true;
        }
        catch (JSException)
        {
            // Clipboard can be blocked on plain http; the password is still visible to copy by hand.
        }
    }
}
