# Copy this file to .env and fill in your values.

# The internal DNS name for the portal (must have an A record pointing at this VM).
PCSERV_HOSTNAME=pcserv.example.org

# Time zone used for dates and timestamps, such as America/New_York.
TZ=UTC

# Everything below is optional, and the app works without it.

# What to call the system that tracks assets and checkouts, and its address for the Open button on the Repairs page.
PCSERV_INVENTORY_NAME=
PCSERV_INVENTORY_URL=

# What to call the console devices are managed from, and its address.
PCSERV_DEVICE_CONSOLE_NAME=
PCSERV_DEVICE_CONSOLE_URL=

# How many digits your asset tags have. The camera scanner then ignores other barcodes, like serial numbers.
PCSERV_ASSET_TAG_DIGITS=
